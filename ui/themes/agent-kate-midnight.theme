{
    "metadata": {
        "name": "Agent Kate Midnight",
        "revision": 1,
        "license": "SPDX-License-Identifier: LGPL-2.0-or-later",
        "author": "The Agent Kate developers"
    },
    "editor-colors": {
        "BackgroundColor": "#0b0e24",
        "CodeFolding": "#1a1e3f",
        "BracketMatching": "#2a2f63",
        "CurrentLine": "#12152e",
        "IconBorder": "#0b0e24",
        "IndentationLine": "#1f2450",
        "LineNumbers": "#565a80",
        "CurrentLineNumber": "#ff2d8e",
        "MarkBookmark": "#38bdf8",
        "MarkBreakpointActive": "#fb5d6e",
        "MarkBreakpointDisabled": "#a855f7",
        "MarkBreakpointReached": "#fbbf24",
        "MarkError": "#fb5d6e",
        "MarkExecution": "#6b6f99",
        "MarkWarning": "#fbbf24",
        "ModifiedLines": "#38bdf8",
        "ReplaceHighlight": "#3a1726",
        "SavedLines": "#34d399",
        "SearchHighlight": "#3b2a5a",
        "Separator": "#1f2450",
        "SpellChecking": "#fb5d6e",
        "TabMarker": "#2a2f63",
        "TemplateBackground": "#1a1e3f",
        "TemplateFocusedPlaceholder": "#7c3aed",
        "TemplatePlaceholder": "#2a2f63",
        "TemplateReadOnlyPlaceholder": "#2c1421",
        "TextSelection": "#7c3aed",
        "WordWrapMarker": "#1a1e3f"
    },
    "text-styles": {
        "Normal":        { "text-color": "#e8e8f6", "selected-text-color": "#ffffff" },
        "Keyword":       { "text-color": "#ff2d8e", "selected-text-color": "#ffffff", "bold": true },
        "Function":      { "text-color": "#c4b5fd", "selected-text-color": "#ffffff" },
        "Variable":      { "text-color": "#e8e8f6", "selected-text-color": "#ffffff" },
        "ControlFlow":   { "text-color": "#ff5cb8", "selected-text-color": "#ffffff", "bold": true },
        "Operator":      { "text-color": "#a855f7", "selected-text-color": "#ffffff" },
        "BuiltIn":       { "text-color": "#c4b5fd", "selected-text-color": "#ffffff" },
        "Extension":     { "text-color": "#c4b5fd", "selected-text-color": "#ffffff" },
        "Preprocessor":  { "text-color": "#fbbf24", "selected-text-color": "#ffffff" },
        "Attribute":     { "text-color": "#38bdf8", "selected-text-color": "#ffffff" },
        "Char":          { "text-color": "#5eead4", "selected-text-color": "#ffffff" },
        "SpecialChar":   { "text-color": "#5eead4", "selected-text-color": "#ffffff" },
        "String":        { "text-color": "#34d399", "selected-text-color": "#ffffff" },
        "VerbatimString":{ "text-color": "#2dd4bf", "selected-text-color": "#ffffff" },
        "SpecialString": { "text-color": "#5eead4", "selected-text-color": "#ffffff" },
        "Import":        { "text-color": "#fbbf24", "selected-text-color": "#ffffff" },
        "DataType":      { "text-color": "#38bdf8", "selected-text-color": "#ffffff" },
        "DecVal":        { "text-color": "#fbbf24", "selected-text-color": "#ffffff" },
        "BaseN":         { "text-color": "#fbbf24", "selected-text-color": "#ffffff" },
        "Float":         { "text-color": "#fbbf24", "selected-text-color": "#ffffff" },
        "Constant":      { "text-color": "#fbbf24", "selected-text-color": "#ffffff" },
        "Comment":       { "text-color": "#6b6f99", "selected-text-color": "#9a9ac0", "italic": true },
        "Documentation": { "text-color": "#8688b3", "selected-text-color": "#c0c0e0", "italic": true },
        "Annotation":    { "text-color": "#a855f7", "selected-text-color": "#ffffff" },
        "CommentVar":    { "text-color": "#8688b3", "selected-text-color": "#ffffff" },
        "RegionMarker":  { "text-color": "#7c3aed", "selected-text-color": "#ffffff", "background-color": "#161a38" },
        "Information":   { "text-color": "#38bdf8", "selected-text-color": "#ffffff" },
        "Warning":       { "text-color": "#fbbf24", "selected-text-color": "#ffffff" },
        "Alert":         { "text-color": "#fb5d6e", "selected-text-color": "#ffffff", "bold": true, "background-color": "#2c1421" },
        "Error":         { "text-color": "#fb5d6e", "selected-text-color": "#ffffff", "underline": true },
        "Others":        { "text-color": "#34d399", "selected-text-color": "#ffffff" }
    }
}
