    "editor-colors": {
        "BackgroundColor": "#ffffff",
        "CodeFolding": "#ece9f7",
        "BracketMatching": "#e0d8f5",
        "CurrentLine": "#f5f3fb",
        "IconBorder": "#f3f2fb",
        "IndentationLine": "#e4e0f2",
        "LineNumbers": "#9c97c4",
        "CurrentLineNumber": "#d6256f",
        "MarkBookmark": "#1f6feb",
        "MarkBreakpointActive": "#c4344a",
        "MarkBreakpointDisabled": "#8b5cf6",
        "MarkBreakpointReached": "#b7791f",
        "MarkError": "#c4344a",
        "MarkExecution": "#9a98ba",
        "MarkWarning": "#b7791f",
        "ModifiedLines": "#1f6feb",
        "ReplaceHighlight": "#fde4ea",
        "SavedLines": "#137a52",
        "SearchHighlight": "#efeafb",
        "Separator": "#e4e0f2",
        "SpellChecking": "#c4344a",
        "TabMarker": "#cdc9e6",
        "TemplateBackground": "#f3f2fb",
        "TemplateFocusedPlaceholder": "#7c3aed",
        "TemplatePlaceholder": "#cdc9e6",
        "TemplateReadOnlyPlaceholder": "#fde4ea",
        "TextSelection": "#d8c9f5",
        "WordWrapMarker": "#ece9f7"
    },
    "text-styles": {
        "Normal":        { "text-color": "#1c1b33", "selected-text-color": "#1c1b33" },
        "Keyword":       { "text-color": "#d6256f", "selected-text-color": "#1c1b33", "bold": true },
        "Function":      { "text-color": "#7c3aed", "selected-text-color": "#1c1b33" },
        "Variable":      { "text-color": "#1c1b33", "selected-text-color": "#1c1b33" },
        "ControlFlow":   { "text-color": "#c01f73", "selected-text-color": "#1c1b33", "bold": true },
        "Operator":      { "text-color": "#8b5cf6", "selected-text-color": "#1c1b33" },
        "BuiltIn":       { "text-color": "#7c3aed", "selected-text-color": "#1c1b33" },
        "Extension":     { "text-color": "#7c3aed", "selected-text-color": "#1c1b33" },
        "Preprocessor":  { "text-color": "#b7791f", "selected-text-color": "#1c1b33" },
        "Attribute":     { "text-color": "#1f6feb", "selected-text-color": "#1c1b33" },
        "Char":          { "text-color": "#0f766e", "selected-text-color": "#1c1b33" },
        "SpecialChar":   { "text-color": "#0f766e", "selected-text-color": "#1c1b33" },
        "String":        { "text-color": "#137a52", "selected-text-color": "#1c1b33" },
        "VerbatimString":{ "text-color": "#0f766e", "selected-text-color": "#1c1b33" },
        "SpecialString": { "text-color": "#0f766e", "selected-text-color": "#1c1b33" },
        "Import":        { "text-color": "#b7791f", "selected-text-color": "#1c1b33" },
        "DataType":      { "text-color": "#1f6feb", "selected-text-color": "#1c1b33" },
        "DecVal":        { "text-color": "#b7791f", "selected-text-color": "#1c1b33" },
        "BaseN":         { "text-color": "#b7791f", "selected-text-color": "#1c1b33" },
        "Float":         { "text-color": "#b7791f", "selected-text-color": "#1c1b33" },
        "Constant":      { "text-color": "#b7791f", "selected-text-color": "#1c1b33" },
        "Comment":       { "text-color": "#8a86ac", "selected-text-color": "#8a86ac", "italic": true },
        "Documentation": { "text-color": "#6b6a8c", "selected-text-color": "#6b6a8c", "italic": true },
        "Annotation":    { "text-color": "#8b5cf6", "selected-text-color": "#1c1b33" },
        "CommentVar":    { "text-color": "#6b6a8c", "selected-text-color": "#1c1b33" },
        "RegionMarker":  { "text-color": "#7c3aed", "selected-text-color": "#1c1b33", "background-color": "#efeafb" },
        "Information":   { "text-color": "#1f6feb", "selected-text-color": "#1c1b33" },
        "Warning":       { "text-color": "#b7791f", "selected-text-color": "#1c1b33" },
        "Alert":         { "text-color": "#c4344a", "selected-text-color": "#1c1b33", "bold": true, "background-color": "#fde4ea" },
        "Error":         { "text-color": "#c4344a", "selected-text-color": "#1c1b33", "underline": true },
        "Others":        { "text-color": "#137a52", "selected-text-color": "#1c1b33" }
    }
}
