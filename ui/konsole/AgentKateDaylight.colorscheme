# Agent Kate Daylight — terminal color scheme matching the signature light theme.
# White canvas, navy ink, pink/violet accents. Installed into the user's Konsole
# data dir by AgentKate; regenerated from the app, so edit the theme in-app
# rather than here.

[Background]
Color=255,255,255

[BackgroundFaint]
Color=243,242,251

[BackgroundIntense]
Color=255,255,255

[Foreground]
Color=28,27,51

[ForegroundFaint]
Color=90,89,120

[ForegroundIntense]
Color=0,0,0

[Color0]
Color=28,27,51

[Color0Intense]
Color=107,106,140

[Color1]
Color=196,52,74

[Color1Intense]
Color=220,80,100

[Color2]
Color=19,122,82

[Color2Intense]
Color=40,160,110

[Color3]
Color=183,121,31

[Color3Intense]
Color=210,150,50

[Color4]
Color=31,111,235

[Color4Intense]
Color=80,140,240

[Color5]
Color=214,37,111

[Color5Intense]
Color=230,70,140

[Color6]
Color=14,116,144

[Color6Intense]
